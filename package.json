{
  "name": "trotline",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "A 3D browser tower defense about fishing an invasive run out of a lake before it spreads.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "shots": "node e2e/shots.mjs",
    "perf": "node e2e/perf.mjs",
    "screens": "node e2e/screens.mjs",
    "smoke": "node e2e/smoke.mjs",
    "art": "node scripts/art.mjs"
  },
  "dependencies": {
    "jsfxr": "1.4.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "@types/three": "0.186.0",
    "playwright": "1.48.2",
    "typescript": "7.0.2",
    "vite": "5.4.10",
    "vitest": "2.1.4"
  }
}
